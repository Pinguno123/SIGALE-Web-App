@model IEnumerable<SIGALE_Web_App.Models.ActividadDAC>
@{
    ViewData["Title"] = "Actividades DAC";
    var categorias = ViewBag.Categorias as List<SIGALE_Web_App.Models.CategoriaDAC> ?? new List<SIGALE_Web_App.Models.CategoriaDAC>();
    var instructores = ViewBag.Instructores as List<SIGALE_Web_App.Models.Usuario> ?? new List<SIGALE_Web_App.Models.Usuario>();
    var estadosActividad = new[] { "Activo", "Inactivo" };
}

<div class="card card-custom p-4 mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <h2 class="h3 fw-bold mb-0 text-dark">
                <i class="bi bi-calendar-event text-danger me-2"></i>Actividades DAC
            </h2>
            <small class="text-muted">Total de registros: <span class="badge bg-secondary rounded-pill">@Model.Count()</span></small>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-sigale shadow-sm px-3" data-bs-toggle="modal" data-bs-target="#modalCrear">
                <i class="bi bi-plus-circle me-1"></i> Nueva Actividad
            </button>
        </div>
    </div>
</div>

<!-- Search box -->
<div class="card card-custom p-3 mb-4">
    <div class="input-group">
        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
        <input type="text" id="filtroTabla" class="form-control border-start-0" placeholder="Filtrar por actividad, categoría o instructor..." />
    </div>
</div>

<!-- Table Card -->
<div class="card card-custom overflow-hidden mb-4">
    <div class="table-responsive">
        <table class="table table-hover table-striped mb-0" id="tablaDatos">
            <thead class="table-light">
                <tr>
                    <th style="width: 80px;">ID</th>
                    <th>Nombre de Actividad</th>
                    <th>Categoría DAC</th>
                    <th>Instructor Asignado</th>
                    <th>Descripción</th>
                    <th style="width: 100px;" class="text-center">Estado</th>
                    <th style="width: 170px;" class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                            No hay actividades DAC registradas.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var a in Model)
                    {
                        <tr>
                            <td class="fw-semibold text-secondary">#@a.IdActividad</td>
                            <td class="fw-bold text-dark">@a.NombreActividad</td>
                            <td><span class="badge bg-primary-subtle text-primary border border-primary-subtle">@a.Categoria?.NombreCategoria</span></td>
                            <td>
                                @if (a.Instructor != null && !string.IsNullOrWhiteSpace(a.Instructor.NombreCompleto))
                                {
                                    <span class="fw-semibold">@a.Instructor.NombreCompleto</span>
                                    <small class="text-muted d-block font-monospace">@a.CarnetInstructor</small>
                                }
                                else
                                {
                                    <span class="text-muted fst-italic">Sin asignar</span>
                                }
                            </td>
                            <td class="text-muted small">
                                @(string.IsNullOrWhiteSpace(a.Descripcion) ? "-" : (a.Descripcion.Length > 80 ? a.Descripcion.Substring(0, 80) + "..." : a.Descripcion))
                            </td>
                            <td class="text-center">
                                @if (a.Estado == "Activo")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Inactivo</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm" role="group">
                                    <button type="button" class="btn btn-outline-primary btn-editar"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalEditar"
                                            data-id="@a.IdActividad"
                                            data-categoria="@a.IdCategoria"
                                            data-nombre="@a.NombreActividad"
                                            data-descripcion="@a.Descripcion"
                                            data-estado="@a.Estado"
                                            data-instructor="@a.CarnetInstructor">
                                        <i class="bi bi-pencil-square"></i> Editar
                                    </button>
                                    <button type="button" class="btn btn-outline-danger btn-eliminar"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalEliminar"
                                            data-id="@a.IdActividad"
                                            data-nombre="@a.NombreActividad">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Crear -->
<div class="modal fade" id="modalCrear" tabindex="-1" aria-labelledby="modalCrearLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <form asp-controller="ActividadesDAC" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title fw-bold" id="modalCrearLabel"><i class="bi bi-calendar-plus me-2"></i>Nueva Actividad DAC</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="createIdCategoria" class="form-label fw-semibold">Categoría DAC <span class="text-danger">*</span></label>
                            <select class="form-select" id="createIdCategoria" name="idCategoria" required>
                                <option value="" disabled selected>Seleccione categoría...</option>
                                @foreach (var cat in categorias)
                                {
                                    <option value="@cat.IdCategoria">@cat.NombreCategoria</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="createNombreActividad" class="form-label fw-semibold">Nombre de la Actividad <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="createNombreActividad" name="nombreActividad" required maxlength="150" placeholder="Ej. Festival de Danza Folklórica" />
                        </div>
                        <div class="col-md-6">
                            <label for="createCarnetInstructor" class="form-label fw-semibold">Instructor / Encargado</label>
                            <select class="form-select" id="createCarnetInstructor" name="carnetInstructor">
                                <option value="">(Sin asignar)</option>
                                @foreach (var ins in instructores)
                                {
                                    <option value="@ins.Carnet">@ins.NombreCompleto (@ins.Carnet)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="createEstado" class="form-label fw-semibold">Estado</label>
                            <select class="form-select" id="createEstado" name="estado">
                                @foreach (var est in estadosActividad)
                                {
                                    <option value="@est">@est</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label for="createDescripcion" class="form-label fw-semibold">Descripción</label>
                            <textarea class="form-control" id="createDescripcion" name="descripcion" rows="3" placeholder="Detalles de la actividad, sede o especificaciones..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger"><i class="bi bi-save me-1"></i> Guardar Actividad</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Editar -->
<div class="modal fade" id="modalEditar" tabindex="-1" aria-labelledby="modalEditarLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <form asp-controller="ActividadesDAC" asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editIdActividad" name="idActividad" />
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title fw-bold" id="modalEditarLabel"><i class="bi bi-pencil-square me-2"></i>Editar Actividad DAC</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="editIdCategoria" class="form-label fw-semibold">Categoría DAC <span class="text-danger">*</span></label>
                            <select class="form-select" id="editIdCategoria" name="idCategoria" required>
                                @foreach (var cat in categorias)
                                {
                                    <option value="@cat.IdCategoria">@cat.NombreCategoria</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="editNombreActividad" class="form-label fw-semibold">Nombre de la Actividad <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="editNombreActividad" name="nombreActividad" required maxlength="150" />
                        </div>
                        <div class="col-md-6">
                            <label for="editCarnetInstructor" class="form-label fw-semibold">Instructor / Encargado</label>
                            <select class="form-select" id="editCarnetInstructor" name="carnetInstructor">
                                <option value="">(Sin asignar)</option>
                                @foreach (var ins in instructores)
                                {
                                    <option value="@ins.Carnet">@ins.NombreCompleto (@ins.Carnet)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="editEstado" class="form-label fw-semibold">Estado</label>
                            <select class="form-select" id="editEstado" name="estado">
                                @foreach (var est in estadosActividad)
                                {
                                    <option value="@est">@est</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label for="editDescripcion" class="form-label fw-semibold">Descripción</label>
                            <textarea class="form-control" id="editDescripcion" name="descripcion" rows="3"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-warning"><i class="bi bi-check-lg me-1"></i> Actualizar Actividad</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Eliminar -->
<div class="modal fade" id="modalEliminar" tabindex="-1" aria-labelledby="modalEliminarLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-controller="ActividadesDAC" asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="deleteIdActividad" name="idActividad" />
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title fw-bold" id="modalEliminarLabel"><i class="bi bi-trash me-2"></i>Confirmar Eliminación</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">
                        ¿Estás seguro de que deseas eliminar la actividad <strong id="deleteNombreActividad" class="text-danger"></strong>?
                    </p>
                    <small class="text-muted d-block mt-2">Esta acción no se puede deshacer.</small>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i> Eliminar Definitivamente</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Modal Editar binding
            var modalEditar = document.getElementById('modalEditar');
            modalEditar.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                document.getElementById('editIdActividad').value = button.getAttribute('data-id');
                document.getElementById('editIdCategoria').value = button.getAttribute('data-categoria');
                document.getElementById('editNombreActividad').value = button.getAttribute('data-nombre');
                document.getElementById('editDescripcion').value = button.getAttribute('data-descripcion') || '';
                document.getElementById('editEstado').value = button.getAttribute('data-estado') || 'Activo';
                document.getElementById('editCarnetInstructor').value = button.getAttribute('data-instructor') || '';
            });

            // Modal Eliminar binding
            var modalEliminar = document.getElementById('modalEliminar');
            modalEliminar.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                document.getElementById('deleteIdActividad').value = button.getAttribute('data-id');
                document.getElementById('deleteNombreActividad').textContent = button.getAttribute('data-nombre');
            });


        });
    </script>
}
