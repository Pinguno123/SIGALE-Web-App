@model IEnumerable<SIGALE_Web_App.Models.InscripcionDAC>
@{
    ViewData["Title"] = "Inscripciones DAC";
    var usuarios = ViewBag.Usuarios as List<SIGALE_Web_App.Models.Usuario> ?? new List<SIGALE_Web_App.Models.Usuario>();
    var actividades = ViewBag.Actividades as List<SIGALE_Web_App.Models.ActividadDAC> ?? new List<SIGALE_Web_App.Models.ActividadDAC>();
    var estadosInscripcion = new[] { "Activa", "Finalizada", "Retirada" };
}

<div class="card card-custom p-4 mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Inscripciones DAC</li>
                </ol>
            </nav>
            <h2 class="h3 fw-bold mb-0 text-dark">
                <i class="bi bi-journal-check text-info me-2"></i>Inscripciones DAC
            </h2>
            <small class="text-muted">Total de registros: <span class="badge bg-secondary rounded-pill">@Model.Count()</span></small>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-sigale shadow-sm px-3" data-bs-toggle="modal" data-bs-target="#modalCrear">
                <i class="bi bi-plus-circle me-1"></i> Nueva Inscripción DAC
            </button>
        </div>
    </div>
</div>

<!-- Search box -->
<div class="card card-custom p-3 mb-4">
    <div class="input-group">
        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
        <input type="text" id="filtroTabla" class="form-control border-start-0" placeholder="Filtrar por estudiante, actividad o estado..." />
    </div>
</div>

<!-- Table Card -->
<div class="card card-custom overflow-hidden mb-4">
    <div class="table-responsive">
        <table class="table table-hover table-striped mb-0" id="tablaDatos">
            <thead class="table-light">
                <tr>
                    <th style="width: 80px;">ID</th>
                    <th>Estudiante</th>
                    <th>Actividad DAC</th>
                    <th>Fecha Inscripción</th>
                    <th class="text-center" style="width: 120px;">Estado</th>
                    <th style="width: 170px;" class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                            No hay inscripciones DAC registradas.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold text-secondary">#@item.IdInscripcionDAC</td>
                            <td>
                                <span class="fw-bold text-dark">@item.Usuario?.NombreCompleto</span>
                                <small class="text-muted d-block font-monospace">@item.Carnet</small>
                            </td>
                            <td class="fw-semibold text-primary">@item.Actividad?.NombreActividad</td>
                            <td class="small">@(item.FechaInscripcion?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                            <td class="text-center">
                                @if (item.EstadoInscripcion == "Activa")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Activa</span>
                                }
                                else if (item.EstadoInscripcion == "Retirada")
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Retirada</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Finalizada</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm" role="group">
                                    <button type="button" class="btn btn-outline-primary btn-editar"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalEditar"
                                            data-id="@item.IdInscripcionDAC"
                                            data-carnet="@item.Carnet"
                                            data-actividad="@item.IdActividad"
                                            data-fecha="@(item.FechaInscripcion?.ToString("yyyy-MM-ddTHH:mm") ?? "")"
                                            data-estado="@item.EstadoInscripcion">
                                        <i class="bi bi-pencil-square"></i> Editar
                                    </button>
                                    <button type="button" class="btn btn-outline-danger btn-eliminar"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalEliminar"
                                            data-id="@item.IdInscripcionDAC"
                                            data-nombre="@item.Usuario?.NombreCompleto en @item.Actividad?.NombreActividad">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Crear -->
<div class="modal fade" id="modalCrear" tabindex="-1" aria-labelledby="modalCrearLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <form asp-controller="InscripcionesDAC" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-info text-dark">
                    <h5 class="modal-title fw-bold" id="modalCrearLabel"><i class="bi bi-journal-plus me-2"></i>Nueva Inscripción DAC</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="createCarnet" class="form-label fw-semibold">Estudiante <span class="text-danger">*</span></label>
                            <select class="form-select" id="createCarnet" name="carnet" required>
                                <option value="" disabled selected>Seleccione un estudiante...</option>
                                @foreach (var u in usuarios)
                                {
                                    <option value="@u.Carnet">@u.NombreCompleto (@u.Carnet)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="createIdActividad" class="form-label fw-semibold">Actividad DAC <span class="text-danger">*</span></label>
                            <select class="form-select" id="createIdActividad" name="idActividad" required>
                                <option value="" disabled selected>Seleccione una actividad...</option>
                                @foreach (var a in actividades)
                                {
                                    <option value="@a.IdActividad">@a.NombreActividad</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="createFechaInscripcion" class="form-label fw-semibold">Fecha de Inscripción</label>
                            <input type="datetime-local" class="form-control" id="createFechaInscripcion" name="fechaInscripcion" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                        </div>
                        <div class="col-md-6">
                            <label for="createEstadoInscripcion" class="form-label fw-semibold">Estado</label>
                            <select class="form-select" id="createEstadoInscripcion" name="estadoInscripcion">
                                @foreach (var est in estadosInscripcion)
                                {
                                    <option value="@est">@est</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-info text-white"><i class="bi bi-save me-1"></i> Guardar Inscripción</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Editar -->
<div class="modal fade" id="modalEditar" tabindex="-1" aria-labelledby="modalEditarLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <form asp-controller="InscripcionesDAC" asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editIdInscripcionDAC" name="idInscripcionDAC" />
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title fw-bold" id="modalEditarLabel"><i class="bi bi-pencil-square me-2"></i>Editar Inscripción DAC</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="editCarnet" class="form-label fw-semibold">Estudiante <span class="text-danger">*</span></label>
                            <select class="form-select" id="editCarnet" name="carnet" required>
                                @foreach (var u in usuarios)
                                {
                                    <option value="@u.Carnet">@u.NombreCompleto (@u.Carnet)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="editIdActividad" class="form-label fw-semibold">Actividad DAC <span class="text-danger">*</span></label>
                            <select class="form-select" id="editIdActividad" name="idActividad" required>
                                @foreach (var a in actividades)
                                {
                                    <option value="@a.IdActividad">@a.NombreActividad</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="editFechaInscripcion" class="form-label fw-semibold">Fecha de Inscripción</label>
                            <input type="datetime-local" class="form-control" id="editFechaInscripcion" name="fechaInscripcion" />
                        </div>
                        <div class="col-md-6">
                            <label for="editEstadoInscripcion" class="form-label fw-semibold">Estado</label>
                            <select class="form-select" id="editEstadoInscripcion" name="estadoInscripcion">
                                @foreach (var est in estadosInscripcion)
                                {
                                    <option value="@est">@est</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-warning"><i class="bi bi-check-lg me-1"></i> Actualizar Inscripción</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Eliminar -->
<div class="modal fade" id="modalEliminar" tabindex="-1" aria-labelledby="modalEliminarLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-controller="InscripcionesDAC" asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="deleteIdInscripcionDAC" name="idInscripcionDAC" />
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title fw-bold" id="modalEliminarLabel"><i class="bi bi-trash me-2"></i>Confirmar Eliminación</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">
                        ¿Estás seguro de que deseas eliminar la inscripción de <strong id="deleteNombreInscripcion" class="text-danger"></strong>?
                    </p>
                    <small class="text-muted d-block mt-2">Esta acción no se puede deshacer.</small>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i> Eliminar Definitivamente</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Modal Editar binding
            var modalEditar = document.getElementById('modalEditar');
            modalEditar.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                document.getElementById('editIdInscripcionDAC').value = button.getAttribute('data-id');
                document.getElementById('editCarnet').value = button.getAttribute('data-carnet');
                document.getElementById('editIdActividad').value = button.getAttribute('data-actividad');
                document.getElementById('editFechaInscripcion').value = button.getAttribute('data-fecha') || '';
                document.getElementById('editEstadoInscripcion').value = button.getAttribute('data-estado') || 'Activa';
            });

            // Modal Eliminar binding
            var modalEliminar = document.getElementById('modalEliminar');
            modalEliminar.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                document.getElementById('deleteIdInscripcionDAC').value = button.getAttribute('data-id');
                document.getElementById('deleteNombreInscripcion').textContent = button.getAttribute('data-nombre');
            });

            // Table filter
            var filtro = document.getElementById('filtroTabla');
            var filas = document.querySelectorAll('#tablaDatos tbody tr');
            filtro.addEventListener('keyup', function () {
                var termino = this.value.toLowerCase().trim();
                filas.forEach(function (fila) {
                    var texto = fila.textContent.toLowerCase();
                    fila.style.display = texto.includes(termino) ? '' : 'none';
                });
            });
        });
    </script>
}
