@model IEnumerable<SIGALE_Web_App.Models.MembresiaAsociacion>
@{
    ViewData["Title"] = "Gestión de Membresías de Asociaciones";
    var usuarios = ViewBag.Usuarios as List<SIGALE_Web_App.Models.Usuario> ?? new List<SIGALE_Web_App.Models.Usuario>();
    var asociaciones = ViewBag.Asociaciones as List<SIGALE_Web_App.Models.Asociacion> ?? new List<SIGALE_Web_App.Models.Asociacion>();
    var rolesMembresia = new[] { "Miembro", "Directiva", "Presidente", "Tesorero", "Secretario" };
    var estadosValidacion = new[] { "Pendiente", "Aprobada", "Rechazada" };
}

<div class="card card-custom p-4 mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Membresías de Asociaciones</li>
                </ol>
            </nav>
            <h2 class="h3 fw-bold mb-0 text-dark">
                <i class="bi bi-person-badge text-warning me-2"></i>Membresías de Asociaciones
            </h2>
            <small class="text-muted">Total de registros: <span class="badge bg-secondary rounded-pill">@Model.Count()</span></small>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-sigale shadow-sm px-3" data-bs-toggle="modal" data-bs-target="#modalCrear">
                <i class="bi bi-plus-circle me-1"></i> Nueva Membresía
            </button>
        </div>
    </div>
</div>

<!-- Search box -->
<div class="card card-custom p-3 mb-4">
    <div class="input-group">
        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
        <input type="text" id="filtroTabla" class="form-control border-start-0" placeholder="Filtrar por carnet, estudiante, asociación, rol o estado..." />
    </div>
</div>

<!-- Table Card -->
<div class="card card-custom overflow-hidden mb-4">
    <div class="table-responsive">
        <table class="table table-hover table-striped mb-0" id="tablaDatos">
            <thead class="table-light">
                <tr>
                    <th style="width: 80px;">ID</th>
                    <th>Estudiante</th>
                    <th>Asociación</th>
                    <th>Rol</th>
                    <th>Fecha Solicitud</th>
                    <th class="text-center">Estado Validación</th>
                    <th style="width: 170px;" class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                            No hay membresías registradas actualmente.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold text-secondary">#@item.IdMembresia</td>
                            <td>
                                <span class="fw-bold text-dark">@item.Usuario?.NombreCompleto</span>
                                <small class="text-muted d-block font-monospace">@item.Carnet</small>
                            </td>
                            <td class="fw-semibold text-primary">@item.Asociacion?.Nombre</td>
                            <td><span class="badge bg-light text-dark border">@item.Rol</span></td>
                            <td class="small">@(item.FechaSolicitud?.ToString("dd/MM/yyyy") ?? "-")</td>
                            <td class="text-center">
                                @if (item.EstadoValidacion == "Aprobada")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Aprobada</span>
                                }
                                else if (item.EstadoValidacion == "Rechazada")
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Rechazada</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">Pendiente</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm" role="group">
                                    <button type="button" class="btn btn-outline-primary btn-editar"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalEditar"
                                            data-id="@item.IdMembresia"
                                            data-carnet="@item.Carnet"
                                            data-asociacion="@item.IdAsociacion"
                                            data-rol="@item.Rol"
                                            data-fecha="@(item.FechaSolicitud?.ToString("yyyy-MM-dd") ?? "")"
                                            data-estado="@item.EstadoValidacion">
                                        <i class="bi bi-pencil-square"></i> Editar
                                    </button>
                                    <button type="button" class="btn btn-outline-danger btn-eliminar"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalEliminar"
                                            data-id="@item.IdMembresia"
                                            data-nombre="@item.Usuario?.NombreCompleto en @item.Asociacion?.Nombre">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Crear -->
<div class="modal fade" id="modalCrear" tabindex="-1" aria-labelledby="modalCrearLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <form asp-controller="MembresiaAsociaciones" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title fw-bold" id="modalCrearLabel"><i class="bi bi-person-badge me-2"></i>Nueva Membresía</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="createCarnet" class="form-label fw-semibold">Estudiante <span class="text-danger">*</span></label>
                            <select class="form-select" id="createCarnet" name="carnet" required>
                                <option value="" disabled selected>Seleccione un estudiante...</option>
                                @foreach (var u in usuarios)
                                {
                                    <option value="@u.Carnet">@u.NombreCompleto (@u.Carnet)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="createIdAsociacion" class="form-label fw-semibold">Asociación <span class="text-danger">*</span></label>
                            <select class="form-select" id="createIdAsociacion" name="idAsociacion" required>
                                <option value="" disabled selected>Seleccione una asociación...</option>
                                @foreach (var a in asociaciones)
                                {
                                    <option value="@a.IdAsociacion">@a.Nombre</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="createRol" class="form-label fw-semibold">Rol en Asociación</label>
                            <select class="form-select" id="createRol" name="rol">
                                @foreach (var r in rolesMembresia)
                                {
                                    <option value="@r">@r</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="createFechaSolicitud" class="form-label fw-semibold">Fecha de Solicitud</label>
                            <input type="date" class="form-control" id="createFechaSolicitud" name="fechaSolicitud" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-4">
                            <label for="createEstadoValidacion" class="form-label fw-semibold">Estado de Validación</label>
                            <select class="form-select" id="createEstadoValidacion" name="estadoValidacion">
                                @foreach (var ev in estadosValidacion)
                                {
                                    <option value="@ev">@ev</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-warning"><i class="bi bi-save me-1"></i> Guardar Membresía</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Editar -->
<div class="modal fade" id="modalEditar" tabindex="-1" aria-labelledby="modalEditarLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <form asp-controller="MembresiaAsociaciones" asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editIdMembresia" name="idMembresia" />
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title fw-bold" id="modalEditarLabel"><i class="bi bi-pencil-square me-2"></i>Editar Membresía</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="editCarnet" class="form-label fw-semibold">Estudiante <span class="text-danger">*</span></label>
                            <select class="form-select" id="editCarnet" name="carnet" required>
                                @foreach (var u in usuarios)
                                {
                                    <option value="@u.Carnet">@u.NombreCompleto (@u.Carnet)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="editIdAsociacion" class="form-label fw-semibold">Asociación <span class="text-danger">*</span></label>
                            <select class="form-select" id="editIdAsociacion" name="idAsociacion" required>
                                @foreach (var a in asociaciones)
                                {
                                    <option value="@a.IdAsociacion">@a.Nombre</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="editRol" class="form-label fw-semibold">Rol en Asociación</label>
                            <select class="form-select" id="editRol" name="rol">
                                @foreach (var r in rolesMembresia)
                                {
                                    <option value="@r">@r</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="editFechaSolicitud" class="form-label fw-semibold">Fecha de Solicitud</label>
                            <input type="date" class="form-control" id="editFechaSolicitud" name="fechaSolicitud" />
                        </div>
                        <div class="col-md-4">
                            <label for="editEstadoValidacion" class="form-label fw-semibold">Estado de Validación</label>
                            <select class="form-select" id="editEstadoValidacion" name="estadoValidacion">
                                @foreach (var ev in estadosValidacion)
                                {
                                    <option value="@ev">@ev</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-warning"><i class="bi bi-check-lg me-1"></i> Actualizar Membresía</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Eliminar -->
<div class="modal fade" id="modalEliminar" tabindex="-1" aria-labelledby="modalEliminarLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-controller="MembresiaAsociaciones" asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="deleteIdMembresia" name="idMembresia" />
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title fw-bold" id="modalEliminarLabel"><i class="bi bi-trash me-2"></i>Confirmar Eliminación</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">
                        ¿Estás seguro de que deseas eliminar el registro de membresía de <strong id="deleteNombreMembresia" class="text-danger"></strong>?
                    </p>
                    <small class="text-muted d-block mt-2">Esta acción no se puede deshacer.</small>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i> Eliminar Definitivamente</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Modal Editar binding
            var modalEditar = document.getElementById('modalEditar');
            modalEditar.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                document.getElementById('editIdMembresia').value = button.getAttribute('data-id');
                document.getElementById('editCarnet').value = button.getAttribute('data-carnet');
                document.getElementById('editIdAsociacion').value = button.getAttribute('data-asociacion');
                document.getElementById('editRol').value = button.getAttribute('data-rol') || 'Miembro';
                document.getElementById('editFechaSolicitud').value = button.getAttribute('data-fecha') || '';
                document.getElementById('editEstadoValidacion').value = button.getAttribute('data-estado') || 'Pendiente';
            });

            // Modal Eliminar binding
            var modalEliminar = document.getElementById('modalEliminar');
            modalEliminar.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                document.getElementById('deleteIdMembresia').value = button.getAttribute('data-id');
                document.getElementById('deleteNombreMembresia').textContent = button.getAttribute('data-nombre');
            });

            // Table filter
            var filtro = document.getElementById('filtroTabla');
            var filas = document.querySelectorAll('#tablaDatos tbody tr');
            filtro.addEventListener('keyup', function () {
                var termino = this.value.toLowerCase().trim();
                filas.forEach(function (fila) {
                    var texto = fila.textContent.toLowerCase();
                    fila.style.display = texto.includes(termino) ? '' : 'none';
                });
            });
        });
    </script>
}
