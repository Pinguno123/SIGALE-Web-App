@model IEnumerable<SIGALE_Web_App.Models.InscripcionCurso>
@{
    ViewData["Title"] = "Inscripciones a Cursos";
    var usuarios = ViewBag.Usuarios as List<SIGALE_Web_App.Models.Usuario> ?? new List<SIGALE_Web_App.Models.Usuario>();
    var cursos = ViewBag.Cursos as List<SIGALE_Web_App.Models.Curso> ?? new List<SIGALE_Web_App.Models.Curso>();
    var estadosInscripcion = new[] { "Confirmada", "En Espera", "Cancelada" };
}

<div class="card card-custom p-4 mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <h2 class="h3 fw-bold mb-0 text-dark">
                <i class="bi bi-clipboard-check text-secondary me-2"></i>Inscripciones a Cursos
            </h2>
            <small class="text-muted">Total de registros: <span class="badge bg-secondary rounded-pill">@Model.Count()</span></small>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-sigale shadow-sm px-3" data-bs-toggle="modal" data-bs-target="#modalCrear">
                <i class="bi bi-plus-circle me-1"></i> Nueva Inscripción
            </button>
        </div>
    </div>
</div>

<!-- Search box -->
<div class="card card-custom p-3 mb-4">
    <div class="input-group">
        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
        <input type="text" id="filtroTabla" class="form-control border-start-0" placeholder="Filtrar por estudiante, carnet, curso o estado..." />
    </div>
</div>

<!-- Table Card -->
<div class="card card-custom overflow-hidden mb-4">
    <div class="table-responsive">
        <table class="table table-hover table-striped mb-0" id="tablaDatos">
            <thead class="table-light">
                <tr>
                    <th style="width: 80px;">ID</th>
                    <th>Estudiante</th>
                    <th>Curso</th>
                    <th style="width: 100px;" class="text-center">Nota</th>
                    <th>Fecha Inscripción</th>
                    <th class="text-center" style="width: 120px;">Estado</th>
                    <th style="width: 170px;" class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                            No hay inscripciones a cursos registradas.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold text-secondary">#@item.IdInscripcion</td>
                            <td>
                                <span class="fw-bold text-dark">@item.Usuario?.NombreCompleto</span>
                                <small class="text-muted d-block font-monospace">@item.Carnet</small>
                            </td>
                            <td class="fw-semibold text-primary">@item.Curso?.NombreCurso</td>
                            <td class="text-center">
                                @if (item.Nota.HasValue)
                                {
                                    <span class="badge bg-light text-dark border fw-bold fs-6">@item.Nota.Value.ToString("F2")</span>
                                }
                                else
                                {
                                    <span class="text-muted fst-italic">-</span>
                                }
                            </td>
                            <td class="small">@(item.FechaInscripcion?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                            <td class="text-center">
                                @if (item.EstadoInscripcion == "Confirmada")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Confirmada</span>
                                }
                                else if (item.EstadoInscripcion == "Cancelada")
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Cancelada</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">En Espera</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm" role="group">
                                    <button type="button" class="btn btn-outline-primary btn-editar"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalEditar"
                                            data-id="@item.IdInscripcion"
                                            data-carnet="@item.Carnet"
                                            data-curso="@item.IdCurso"
                                            data-nota="@(item.Nota?.ToString() ?? "")"
                                            data-fecha="@(item.FechaInscripcion?.ToString("yyyy-MM-ddTHH:mm") ?? "")"
                                            data-estado="@item.EstadoInscripcion">
                                        <i class="bi bi-pencil-square"></i> Editar
                                    </button>
                                    <button type="button" class="btn btn-outline-danger btn-eliminar"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalEliminar"
                                            data-id="@item.IdInscripcion"
                                            data-nombre="@item.Usuario?.NombreCompleto en @item.Curso?.NombreCurso">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Crear -->
<div class="modal fade" id="modalCrear" tabindex="-1" aria-labelledby="modalCrearLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <form asp-controller="InscripcionCursos" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-secondary text-white">
                    <h5 class="modal-title fw-bold" id="modalCrearLabel"><i class="bi bi-clipboard-plus me-2"></i>Nueva Inscripción a Curso</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="createCarnet" class="form-label fw-semibold">Estudiante <span class="text-danger">*</span></label>
                            <select class="form-select" id="createCarnet" name="carnet" required>
                                <option value="" disabled selected>Seleccione un estudiante...</option>
                                @foreach (var u in usuarios)
                                {
                                    <option value="@u.Carnet">@u.NombreCompleto (@u.Carnet)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="createIdCurso" class="form-label fw-semibold">Curso <span class="text-danger">*</span></label>
                            <select class="form-select" id="createIdCurso" name="idCurso" required>
                                <option value="" disabled selected>Seleccione un curso...</option>
                                @foreach (var c in cursos)
                                {
                                    <option value="@c.IdCurso">@c.NombreCurso</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="createNota" class="form-label fw-semibold">Nota (0 - 100)</label>
                            <input type="number" step="0.01" class="form-control" id="createNota" name="nota" min="0" max="100" placeholder="Ej. 85.50" />
                        </div>
                        <div class="col-md-4">
                            <label for="createFechaInscripcion" class="form-label fw-semibold">Fecha Inscripción</label>
                            <input type="datetime-local" class="form-control" id="createFechaInscripcion" name="fechaInscripcion" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                        </div>
                        <div class="col-md-4">
                            <label for="createEstadoInscripcion" class="form-label fw-semibold">Estado</label>
                            <select class="form-select" id="createEstadoInscripcion" name="estadoInscripcion">
                                @foreach (var est in estadosInscripcion)
                                {
                                    <option value="@est">@est</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-secondary text-white"><i class="bi bi-save me-1"></i> Guardar Inscripción</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Editar -->
<div class="modal fade" id="modalEditar" tabindex="-1" aria-labelledby="modalEditarLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <form asp-controller="InscripcionCursos" asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editIdInscripcion" name="idInscripcion" />
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title fw-bold" id="modalEditarLabel"><i class="bi bi-pencil-square me-2"></i>Editar Inscripción</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="editCarnet" class="form-label fw-semibold">Estudiante <span class="text-danger">*</span></label>
                            <select class="form-select" id="editCarnet" name="carnet" required>
                                @foreach (var u in usuarios)
                                {
                                    <option value="@u.Carnet">@u.NombreCompleto (@u.Carnet)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="editIdCurso" class="form-label fw-semibold">Curso <span class="text-danger">*</span></label>
                            <select class="form-select" id="editIdCurso" name="idCurso" required>
                                @foreach (var c in cursos)
                                {
                                    <option value="@c.IdCurso">@c.NombreCurso</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="editNota" class="form-label fw-semibold">Nota (0 - 100)</label>
                            <input type="number" step="0.01" class="form-control" id="editNota" name="nota" min="0" max="100" />
                        </div>
                        <div class="col-md-4">
                            <label for="editFechaInscripcion" class="form-label fw-semibold">Fecha Inscripción</label>
                            <input type="datetime-local" class="form-control" id="editFechaInscripcion" name="fechaInscripcion" />
                        </div>
                        <div class="col-md-4">
                            <label for="editEstadoInscripcion" class="form-label fw-semibold">Estado</label>
                            <select class="form-select" id="editEstadoInscripcion" name="estadoInscripcion">
                                @foreach (var est in estadosInscripcion)
                                {
                                    <option value="@est">@est</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-warning"><i class="bi bi-check-lg me-1"></i> Actualizar Inscripción</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Eliminar -->
<div class="modal fade" id="modalEliminar" tabindex="-1" aria-labelledby="modalEliminarLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-controller="InscripcionCursos" asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="deleteIdInscripcion" name="idInscripcion" />
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title fw-bold" id="modalEliminarLabel"><i class="bi bi-trash me-2"></i>Confirmar Eliminación</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">
                        ¿Estás seguro de que deseas eliminar la inscripción de <strong id="deleteNombreInscripcion" class="text-danger"></strong>?
                    </p>
                    <small class="text-muted d-block mt-2">Esta acción no se puede deshacer.</small>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i> Eliminar Definitivamente</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Modal Editar binding
            var modalEditar = document.getElementById('modalEditar');
            modalEditar.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                document.getElementById('editIdInscripcion').value = button.getAttribute('data-id');
                document.getElementById('editCarnet').value = button.getAttribute('data-carnet');
                document.getElementById('editIdCurso').value = button.getAttribute('data-curso');
                document.getElementById('editNota').value = button.getAttribute('data-nota') || '';
                document.getElementById('editFechaInscripcion').value = button.getAttribute('data-fecha') || '';
                document.getElementById('editEstadoInscripcion').value = button.getAttribute('data-estado') || 'Confirmada';
            });

            // Modal Eliminar binding
            var modalEliminar = document.getElementById('modalEliminar');
            modalEliminar.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                document.getElementById('deleteIdInscripcion').value = button.getAttribute('data-id');
                document.getElementById('deleteNombreInscripcion').textContent = button.getAttribute('data-nombre');
            });


        });
    </script>
}
