@model IEnumerable<SIGALE_Web_App.Models.Usuario>
@{
    ViewData["Title"] = "Gestión de Usuarios";
    var roles = ViewBag.Roles as List<SIGALE_Web_App.Models.Rol> ?? new List<SIGALE_Web_App.Models.Rol>();
}

<div class="card card-custom p-4 mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>

            <h2 class="h3 fw-bold mb-0 text-dark">
                <i class="bi bi-people text-success me-2"></i>Gestión de Usuarios
            </h2>
            <small class="text-muted">Total de registros: <span class="badge bg-secondary rounded-pill">@Model.Count()</span></small>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-sigale shadow-sm px-3" data-bs-toggle="modal" data-bs-target="#modalCrear">
                <i class="bi bi-person-plus me-1"></i> Nuevo Usuario
            </button>
        </div>
    </div>
</div>

<!-- Search box -->
<div class="card card-custom p-3 mb-4">
    <div class="input-group">
        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
        <input type="text" id="filtroTabla" class="form-control border-start-0" placeholder="Filtrar por carnet, nombre, carrera, campus, correo o rol..." />
    </div>
</div>

<!-- Table Card -->
<div class="card card-custom overflow-hidden mb-4">
    <div class="table-responsive">
        <table class="table table-hover table-striped mb-0" id="tablaDatos">
            <thead class="table-light">
                <tr>
                    <th style="width: 120px;">Carnet</th>
                    <th>Nombre Completo</th>
                    <th>Carrera</th>
                    <th>Campus</th>
                    <th>Correo</th>
                    <th>Rol</th>
                    <th style="width: 90px;" class="text-center">Estado</th>
                    <th style="width: 170px;" class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                            No hay usuarios registrados actualmente.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var usuario in Model)
                    {
                        <tr>
                            <td class="fw-bold font-monospace text-primary">@usuario.Carnet</td>
                            <td class="fw-semibold">@usuario.NombreCompleto</td>
                            <td>@usuario.Carrera</td>
                            <td><span class="badge bg-light text-dark border">@usuario.Campus</span></td>
                            <td class="small text-muted"><i class="bi bi-envelope me-1"></i>@usuario.CorreoElectronico</td>
                            <td><span class="badge bg-primary-subtle text-primary border border-primary-subtle">@usuario.Rol?.NombreRol</span></td>
                            <td class="text-center">
                                @if (usuario.Activo)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Inactivo</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm" role="group">
                                    <button type="button" class="btn btn-outline-primary btn-editar"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalEditar"
                                            data-carnet="@usuario.Carnet"
                                            data-nombre="@usuario.NombreCompleto"
                                            data-carrera="@usuario.Carrera"
                                            data-campus="@usuario.Campus"
                                            data-correo="@usuario.CorreoElectronico"
                                            data-rol="@usuario.IdRol"
                                            data-activo="@(usuario.Activo ? "true" : "false")">
                                        <i class="bi bi-pencil-square"></i> Editar
                                    </button>
                                    <button type="button" class="btn btn-outline-danger btn-eliminar"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalEliminar"
                                            data-carnet="@usuario.Carnet"
                                            data-nombre="@usuario.NombreCompleto">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Crear -->
<div class="modal fade" id="modalCrear" tabindex="-1" aria-labelledby="modalCrearLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <form asp-controller="Usuarios" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title fw-bold" id="modalCrearLabel"><i class="bi bi-person-plus me-2"></i>Nuevo Usuario</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="createCarnet" class="form-label fw-semibold">Carnet <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="createCarnet" name="carnet" required maxlength="10" placeholder="Ej. 2024-0012U" />
                        </div>
                        <div class="col-md-6">
                            <label for="createNombreCompleto" class="form-label fw-semibold">Nombre Completo <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="createNombreCompleto" name="nombreCompleto" required maxlength="100" placeholder="Ej. Juan Pérez López" />
                        </div>
                        <div class="col-md-6">
                            <label for="createCarrera" class="form-label fw-semibold">Carrera <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="createCarrera" name="carrera" required maxlength="150" placeholder="Ej. Ingeniería en Sistemas" />
                        </div>
                        <div class="col-md-6">
                            <label for="createCampus" class="form-label fw-semibold">Campus <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="createCampus" name="campus" required maxlength="100" placeholder="Ej. Central, Norte..." />
                        </div>
                        <div class="col-md-6">
                            <label for="createCorreo" class="form-label fw-semibold">Correo Electrónico <span class="text-danger">*</span></label>
                            <input type="email" class="form-control" id="createCorreo" name="correoElectronico" required maxlength="50" placeholder="estudiante@correo.com" />
                        </div>
                        <div class="col-md-6">
                            <label for="createIdRol" class="form-label fw-semibold">Rol Asignado <span class="text-danger">*</span></label>
                            <select class="form-select" id="createIdRol" name="idRol" required>
                                <option value="" disabled selected>Seleccione un rol...</option>
                                @foreach (var r in roles)
                                {
                                    <option value="@r.IdRol">@r.NombreRol</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" id="createActivo" name="activo" value="true" checked />
                                <label class="form-check-label fw-semibold" for="createActivo">Usuario Activo</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success"><i class="bi bi-save me-1"></i> Guardar Usuario</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Editar -->
<div class="modal fade" id="modalEditar" tabindex="-1" aria-labelledby="modalEditarLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <form asp-controller="Usuarios" asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title fw-bold" id="modalEditarLabel"><i class="bi bi-pencil-square me-2"></i>Editar Usuario</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="editCarnet" class="form-label fw-semibold">Carnet (Identificador)</label>
                            <input type="text" class="form-control bg-light" id="editCarnet" name="carnet" readonly />
                        </div>
                        <div class="col-md-6">
                            <label for="editNombreCompleto" class="form-label fw-semibold">Nombre Completo <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="editNombreCompleto" name="nombreCompleto" required maxlength="100" />
                        </div>
                        <div class="col-md-6">
                            <label for="editCarrera" class="form-label fw-semibold">Carrera <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="editCarrera" name="carrera" required maxlength="150" />
                        </div>
                        <div class="col-md-6">
                            <label for="editCampus" class="form-label fw-semibold">Campus <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="editCampus" name="campus" required maxlength="100" />
                        </div>
                        <div class="col-md-6">
                            <label for="editCorreo" class="form-label fw-semibold">Correo Electrónico <span class="text-danger">*</span></label>
                            <input type="email" class="form-control" id="editCorreo" name="correoElectronico" required maxlength="50" />
                        </div>
                        <div class="col-md-6">
                            <label for="editIdRol" class="form-label fw-semibold">Rol Asignado <span class="text-danger">*</span></label>
                            <select class="form-select" id="editIdRol" name="idRol" required>
                                @foreach (var r in roles)
                                {
                                    <option value="@r.IdRol">@r.NombreRol</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" id="editActivo" name="activo" value="true" />
                                <label class="form-check-label fw-semibold" for="editActivo">Usuario Activo</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-warning"><i class="bi bi-check-lg me-1"></i> Actualizar Usuario</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Eliminar -->
<div class="modal fade" id="modalEliminar" tabindex="-1" aria-labelledby="modalEliminarLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-controller="Usuarios" asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="deleteCarnet" name="carnet" />
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title fw-bold" id="modalEliminarLabel"><i class="bi bi-trash me-2"></i>Confirmar Eliminación</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">
                        ¿Estás seguro de que deseas eliminar al usuario <strong id="deleteNombreUsuario" class="text-danger"></strong> (<span id="deleteCarnetSpan" class="font-monospace"></span>)?
                    </p>
                    <small class="text-muted d-block mt-2">Esta acción no se puede deshacer.</small>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i> Eliminar Definitivamente</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Modal Editar binding
            var modalEditar = document.getElementById('modalEditar');
            modalEditar.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                document.getElementById('editCarnet').value = button.getAttribute('data-carnet');
                document.getElementById('editNombreCompleto').value = button.getAttribute('data-nombre');
                document.getElementById('editCarrera').value = button.getAttribute('data-carrera');
                document.getElementById('editCampus').value = button.getAttribute('data-campus');
                document.getElementById('editCorreo').value = button.getAttribute('data-correo');
                document.getElementById('editIdRol').value = button.getAttribute('data-rol');
                document.getElementById('editActivo').checked = button.getAttribute('data-activo') === 'true';
            });

            // Modal Eliminar binding
            var modalEliminar = document.getElementById('modalEliminar');
            modalEliminar.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                var carnet = button.getAttribute('data-carnet');
                document.getElementById('deleteCarnet').value = carnet;
                document.getElementById('deleteCarnetSpan').textContent = carnet;
                document.getElementById('deleteNombreUsuario').textContent = button.getAttribute('data-nombre');
            });


        });
    </script>
}