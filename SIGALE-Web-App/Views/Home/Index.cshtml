@{
    ViewData["Title"] = "Panel de Gestión de SIGALE";
}

<div class="mb-4">
    <h1 class="h2 fw-bold text-dark mb-0">
        Panel de Gestión de SIGALE
    </h1>
</div>

<div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
    <!-- 1. Roles -->
    <div class="col">
        <div class="card card-custom h-100">
            <div class="card-body p-4 d-flex flex-column">
                <div class="d-flex align-items-center mb-3">
                    <div class="p-3 rounded-circle me-3 d-flex align-items-center justify-content-center" style="background-color: var(--sigale-bg-bone); color: var(--sigale-dark); width: 56px; height: 56px;">
                        <i class="bi bi-shield-lock fs-4"></i>
                    </div>
                    <div>
                        <h5 class="card-title fw-bold mb-0 text-dark">Roles</h5>
                    </div>
                </div>
                <p class="card-text text-muted flex-grow-1 small">
                    Gestión de roles de permisos para el acceso y privilegios de usuarios en el sistema.
                </p>
                <a asp-controller="Roles" asp-action="Index" class="btn btn-sigale btn-sm w-100 mt-2">
                    <i class="bi bi-arrow-right-circle me-1"></i> Ir a Roles
                </a>
            </div>
        </div>
    </div>

    <!-- 2. Usuarios -->
    <div class="col">
        <div class="card card-custom h-100">
            <div class="card-body p-4 d-flex flex-column">
                <div class="d-flex align-items-center mb-3">
                    <div class="p-3 rounded-circle me-3 d-flex align-items-center justify-content-center" style="background-color: var(--sigale-bg-bone); color: var(--sigale-dark); width: 56px; height: 56px;">
                        <i class="bi bi-people fs-4"></i>
                    </div>
                    <div>
                        <h5 class="card-title fw-bold mb-0 text-dark">Usuarios</h5>
                    </div>
                </div>
                <p class="card-text text-muted flex-grow-1 small">
                    Administración de estudiantes, instructores y miembros con sus datos institucionales.
                </p>
                <a asp-controller="Usuarios" asp-action="Index" class="btn btn-sigale btn-sm w-100 mt-2">
                    <i class="bi bi-arrow-right-circle me-1"></i> Ir a Usuarios
                </a>
            </div>
        </div>
    </div>

    <!-- 3. Asociaciones -->
    <div class="col">
        <div class="card card-custom h-100">
            <div class="card-body p-4 d-flex flex-column">
                <div class="d-flex align-items-center mb-3">
                    <div class="p-3 rounded-circle me-3 d-flex align-items-center justify-content-center" style="background-color: var(--sigale-bg-bone); color: var(--sigale-dark); width: 56px; height: 56px;">
                        <i class="bi bi-building fs-4"></i>
                    </div>
                    <div>
                        <h5 class="card-title fw-bold mb-0 text-dark">Asociaciones</h5>
                    </div>
                </div>
                <p class="card-text text-muted flex-grow-1 small">
                    Clubs, ramas y asociaciones estudiantiles con información de fundación y formularios.
                </p>
                <a asp-controller="Asociaciones" asp-action="Index" class="btn btn-sigale btn-sm w-100 mt-2">
                    <i class="bi bi-arrow-right-circle me-1"></i> Ir a Asociaciones
                </a>
            </div>
        </div>
    </div>

    <!-- 4. Membresias -->
    <div class="col">
        <div class="card card-custom h-100">
            <div class="card-body p-4 d-flex flex-column">
                <div class="d-flex align-items-center mb-3">
                    <div class="p-3 rounded-circle me-3 d-flex align-items-center justify-content-center" style="background-color: var(--sigale-bg-bone); color: var(--sigale-dark); width: 56px; height: 56px;">
                        <i class="bi bi-person-badge fs-4"></i>
                    </div>
                    <div>
                        <h5 class="card-title fw-bold mb-0 text-dark">Membresías de Asociaciones</h5>
                    </div>
                </div>
                <p class="card-text text-muted flex-grow-1 small">
                    Registro y validación de membresías y cargos directivos en las distintas asociaciones.
                </p>
                <a asp-controller="MembresiaAsociaciones" asp-action="Index" class="btn btn-sigale btn-sm w-100 mt-2">
                    <i class="bi bi-arrow-right-circle me-1"></i> Ir a Membresías
                </a>
            </div>
        </div>
    </div>

    <!-- 5. Cursos -->
    <div class="col">
        <div class="card card-custom h-100">
            <div class="card-body p-4 d-flex flex-column">
                <div class="d-flex align-items-center mb-3">
                    <div class="p-3 rounded-circle me-3 d-flex align-items-center justify-content-center" style="background-color: var(--sigale-bg-bone); color: var(--sigale-dark); width: 56px; height: 56px;">
                        <i class="bi bi-journal-bookmark fs-4"></i>
                    </div>
                    <div>
                        <h5 class="card-title fw-bold mb-0 text-dark">Cursos</h5>
                    </div>
                </div>
                <p class="card-text text-muted flex-grow-1 small">
                    Cursos y talleres extracurriculares ofrecidos, con horarios, cupos e instructores.
                </p>
                <a asp-controller="Cursos" asp-action="Index" class="btn btn-sigale btn-sm w-100 mt-2">
                    <i class="bi bi-arrow-right-circle me-1"></i> Ir a Cursos
                </a>
            </div>
        </div>
    </div>

    <!-- 6. Inscripciones Cursos -->
    <div class="col">
        <div class="card card-custom h-100">
            <div class="card-body p-4 d-flex flex-column">
                <div class="d-flex align-items-center mb-3">
                    <div class="p-3 rounded-circle me-3 d-flex align-items-center justify-content-center" style="background-color: var(--sigale-bg-bone); color: var(--sigale-dark); width: 56px; height: 56px;">
                        <i class="bi bi-clipboard-check fs-4"></i>
                    </div>
                    <div>
                        <h5 class="card-title fw-bold mb-0 text-dark">Inscripciones a Cursos</h5>
                    </div>
                </div>
                <p class="card-text text-muted flex-grow-1 small">
                    Control de inscripciones de estudiantes a cursos, registro de notas y estado.
                </p>
                <a asp-controller="InscripcionCursos" asp-action="Index" class="btn btn-sigale btn-sm w-100 mt-2">
                    <i class="bi bi-arrow-right-circle me-1"></i> Ir a Inscripciones
                </a>
            </div>
        </div>
    </div>

    <!-- 7. Selecciones Deportivas -->
    <div class="col">
        <div class="card card-custom h-100">
            <div class="card-body p-4 d-flex flex-column">
                <div class="d-flex align-items-center mb-3">
                    <div class="p-3 rounded-circle me-3 d-flex align-items-center justify-content-center" style="background-color: var(--sigale-bg-bone); color: var(--sigale-dark); width: 56px; height: 56px;">
                        <i class="bi bi-trophy fs-4"></i>
                    </div>
                    <div>
                        <h5 class="card-title fw-bold mb-0 text-dark">Selecciones Deportivas</h5>
                    </div>
                </div>
                <p class="card-text text-muted flex-grow-1 small">
                    Equipos deportivos representativos clasificados por disciplina y rama.
                </p>
                <a asp-controller="SeleccionesDeportivas" asp-action="Index" class="btn btn-sigale btn-sm w-100 mt-2">
                    <i class="bi bi-arrow-right-circle me-1"></i> Ir a Selecciones
                </a>
            </div>
        </div>
    </div>

    <!-- 8. Participaciones Deportivas -->
    <div class="col">
        <div class="card card-custom h-100">
            <div class="card-body p-4 d-flex flex-column">
                <div class="d-flex align-items-center mb-3">
                    <div class="p-3 rounded-circle me-3 d-flex align-items-center justify-content-center" style="background-color: var(--sigale-bg-bone); color: var(--sigale-dark); width: 56px; height: 56px;">
                        <i class="bi bi-activity fs-4"></i>
                    </div>
                    <div>
                        <h5 class="card-title fw-bold mb-0 text-dark">Participaciones Deportivas</h5>
                    </div>
                </div>
                <p class="card-text text-muted flex-grow-1 small">
                    Atletas integrantes de las selecciones deportivas, modalidades e ingreso.
                </p>
                <a asp-controller="ParticipacionDeportiva" asp-action="Index" class="btn btn-sigale btn-sm w-100 mt-2">
                    <i class="bi bi-arrow-right-circle me-1"></i> Ir a Participaciones
                </a>
            </div>
        </div>
    </div>

    <!-- 9. Categorías DAC -->
    <div class="col">
        <div class="card card-custom h-100">
            <div class="card-body p-4 d-flex flex-column">
                <div class="d-flex align-items-center mb-3">
                    <div class="p-3 rounded-circle me-3 d-flex align-items-center justify-content-center" style="background-color: var(--sigale-bg-bone); color: var(--sigale-dark); width: 56px; height: 56px;">
                        <i class="bi bi-tags fs-4"></i>
                    </div>
                    <div>
                        <h5 class="card-title fw-bold mb-0 text-dark">Categorías DAC</h5>
                    </div>
                </div>
                <p class="card-text text-muted flex-grow-1 small">
                    Clasificación y rubros de las actividades culturales y de desarrollo estudiantil.
                </p>
                <a asp-controller="CategoriasDAC" asp-action="Index" class="btn btn-sigale btn-sm w-100 mt-2">
                    <i class="bi bi-arrow-right-circle me-1"></i> Ir a Categorías DAC
                </a>
            </div>
        </div>
    </div>

    <!-- 10. Actividades DAC -->
    <div class="col">
        <div class="card card-custom h-100">
            <div class="card-body p-4 d-flex flex-column">
                <div class="d-flex align-items-center mb-3">
                    <div class="p-3 rounded-circle me-3 d-flex align-items-center justify-content-center" style="background-color: var(--sigale-bg-bone); color: var(--sigale-dark); width: 56px; height: 56px;">
                        <i class="bi bi-calendar-event fs-4"></i>
                    </div>
                    <div>
                        <h5 class="card-title fw-bold mb-0 text-dark">Actividades DAC</h5>
                    </div>
                </div>
                <p class="card-text text-muted flex-grow-1 small">
                    Eventos, talleres y actividades organizadas con su categoría e instructor.
                </p>
                <a asp-controller="ActividadesDAC" asp-action="Index" class="btn btn-sigale btn-sm w-100 mt-2">
                    <i class="bi bi-arrow-right-circle me-1"></i> Ir a Actividades DAC
                </a>
            </div>
        </div>
    </div>

    <!-- 11. Inscripciones DAC -->
    <div class="col">
        <div class="card card-custom h-100">
            <div class="card-body p-4 d-flex flex-column">
                <div class="d-flex align-items-center mb-3">
                    <div class="p-3 rounded-circle me-3 d-flex align-items-center justify-content-center" style="background-color: var(--sigale-bg-bone); color: var(--sigale-dark); width: 56px; height: 56px;">
                        <i class="bi bi-journal-check fs-4"></i>
                    </div>
                    <div>
                        <h5 class="card-title fw-bold mb-0 text-dark">Inscripciones DAC</h5>
                    </div>
                </div>
                <p class="card-text text-muted flex-grow-1 small">
                    Estudiantes participantes y registros de asistencia en actividades DAC.
                </p>
                <a asp-controller="InscripcionesDAC" asp-action="Index" class="btn btn-sigale btn-sm w-100 mt-2">
                    <i class="bi bi-arrow-right-circle me-1"></i> Ir a Inscripciones DAC
                </a>
            </div>
        </div>
    </div>
</div>
